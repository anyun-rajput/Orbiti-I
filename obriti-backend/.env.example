# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@host:port/database_name

# JWT Secret Key (use a strong random string - minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters

# SMTP Configuration
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com

# Nessus Configuration (stored in database, but these are optional for testing)
NESSUS_API_URL=https://nessus.example.com:8834
NESSUS_ACCESS_KEY=your-nessus-access-key
NESSUS_SECRET_KEY=your-nessus-secret-key

# API Tokens (use environment-specific tokens)
API_ACCESS_TOKEN=your-api-access-token-here

# Azure/Microsoft Configuration
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Admin User (used for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_EMAIL=admin@example.com

# Application Settings
DEBUG=False
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security
ALLOWED_HOSTS=localhost,127.0.0.1,example.com
CORS_ORIGINS=https://example.com

# Optional: Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elastic-password
