import { useState, useEffect } from "react";
import { Search, RefreshCw, Monitor, AlertCircle, CheckCircle, XCircle, ChevronLeft, ChevronRight, Plus, Edit, Trash2, MoreHorizontal, Filter } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Input } from "@/components/ui/input";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from "@/components/ui/dropdown-menu";
import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogContent, AlertDialogDescription, AlertDialogFooter, AlertDialogHeader, AlertDialogTitle, AlertDialogTrigger } from "@/components/ui/alert-dialog";
import { useToast } from "@/hooks/use-toast";
import React, { ChangeEvent } from "react";
import { useApiFetch } from "@/lib/utils";

interface Asset {
  id: number;
  hostname: string;
  host_ip: string;
  last_scan_date: string | null;
  status: string | null;
  server_owner: string | null;
  application_dependent: string | null;
  os_name: string | null;
}

interface AssetCreate {
  hostname: string;
  host_ip: string;
  server_owner?: string;
  application_dependent?: string;
  os_name?: string;
  status?: string;
}

interface AssetUpdate {
  hostname?: string;
  host_ip?: string;
  server_owner?: string;
  application_dependent?: string;
  os_name?: string;
  status?: string;
}

interface AssetStats {
  total_assets: number;
  active_assets: number;
  inactive_assets: number;
  os_distribution: Record<string, number>;
  owner_distribution: Record<string, number>;
}

export function AssetManagement() {
  const [assets, setAssets] = useState<Asset[]>([]);
  const [searchTerm, setSearchTerm] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [ownerFilter, setOwnerFilter] = useState("all");
  const [osFilter, setOsFilter] = useState("all");
  const [isLoading, setIsLoading] = useState(false);
  const [showCreateModal, setShowCreateModal] = useState(false);
  const [showEditModal, setShowEditModal] = useState(false);
  const [selectedAsset, setSelectedAsset] = useState<Asset | null>(null);
  const [newAsset, setNewAsset] = useState<AssetCreate>({
    hostname: "",
    host_ip: "",
    server_owner: "",
    application_dependent: "",
    os_name: "Unknown",
    status: "online"
  });
  const [editAsset, setEditAsset] = useState<AssetUpdate>({});
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(20);
  const [totalPages, setTotalPages] = useState(1);
  const [totalCount, setTotalCount] = useState(0);
  const [ownerOptions, setOwnerOptions] = useState<string[]>([]);
  const [osOptions, setOsOptions] = useState<string[]>([]);
  const [assetStats, setAssetStats] = useState<AssetStats | null>(null);
  const [showDeleteDialog, setShowDeleteDialog] = useState(false);
  const [assetToDelete, setAssetToDelete] = useState<Asset | null>(null);
  const [showBulkDeleteDialog, setShowBulkDeleteDialog] = useState(false);
  const [selectedAssets, setSelectedAssets] = useState<number[]>([]);
  const [showCsvUploadModal, setShowCsvUploadModal] = useState(false);
  const [csvFile, setCsvFile] = useState<File | null>(null);
  const [isCsvUploading, setIsCsvUploading] = useState(false);
  const apiFetch = useApiFetch();
  const { toast } = useToast();

  // Fetch asset statistics (using existing hosts data)
  const fetchAssetStats = async () => {
    try {
      // Get all hosts to calculate stats
      const response = await apiFetch("https://orbiti.fareportal.com:7000/api/hosts", {
        headers: { accept: 'application/json' }
      });
      if (response.ok) {
        const data = await response.json();
        const hosts = data.hosts || [];
        
        // Calculate stats from hosts data
        const total_assets = hosts.length;
        
        // Debug: Log all unique status values
        const uniqueStatuses = Array.from(new Set(hosts.map((h: any) => h.status).filter(Boolean)));
        console.log('Unique status values in database:', uniqueStatuses);
        
        const active_assets = hosts.filter((h: any) => {
          if (!h.status) return false;
          const status = h.status.toLowerCase();
          return status === "online" || status === "active";
        }).length;
        const inactive_assets = hosts.filter((h: any) => {
          if (!h.status) return false;
          const status = h.status.toLowerCase();
          return status === "offline" || status === "inactive";
        }).length;
        
        // OS distribution
        const osCounts: Record<string, number> = {};
        hosts.forEach((h: any) => {
          const os = h.os_name || "Unknown";
          osCounts[os] = (osCounts[os] || 0) + 1;
        });
        
        // Owner distribution
        const ownerCounts: Record<string, number> = {};
        hosts.forEach((h: any) => {
          const owner = h.server_owner || "Unknown";
          ownerCounts[owner] = (ownerCounts[owner] || 0) + 1;
        });
        
        setAssetStats({
          total_assets,
          active_assets,
          inactive_assets,
          os_distribution: osCounts,
          owner_distribution: ownerCounts
        });
      }
    } catch (error) {
      console.error('Error fetching asset stats:', error);
    }
  };

  // Fetch asset owners from existing hosts data
  const fetchAssetOwners = async () => {
    try {
      const response = await apiFetch("https://orbiti.fareportal.com:7000/api/hosts", {
        headers: { accept: 'application/json' }
      });
      if (response.ok) {
        const data = await response.json();
        const hosts = data.hosts || [];
        
        // Extract unique owners
        const owners = Array.from(new Set(
          hosts.map((h: any) => h.server_owner).filter(Boolean)
        )) as string[];
        setOwnerOptions(owners);
      }
    } catch (error) {
      console.error('Error fetching asset owners:', error);
    }
  };

  // Fetch OS types from existing hosts data
  const fetchOsTypes = async () => {
    try {
      const response = await apiFetch("https://orbiti.fareportal.com:7000/api/hosts", {
        headers: { accept: 'application/json' }
      });
      if (response.ok) {
        const data = await response.json();
        const hosts = data.hosts || [];
        
        // Extract unique OS types
        const osTypes = Array.from(new Set(
          hosts.map((h: any) => h.os_name).filter(Boolean)
        )) as string[];
        setOsOptions(osTypes);
      }
    } catch (error) {
      console.error('Error fetching OS types:', error);
    }
  };

  // Fetch assets with pagination and filtering using existing hosts API
  const fetchAssets = async () => {
    setIsLoading(true);
    try {
      const params = new URLSearchParams();
      
      // Add pagination parameters
      params.append('page', page.toString());
      params.append('page_size', pageSize.toString());
      
      // Add search parameter only if not empty
      if (searchTerm.trim()) {
        params.append('search', searchTerm.trim());
      }
      
      // Add filter parameters only if not "all"
      if (statusFilter !== "all") {
        params.append('status', statusFilter);
      }
      
      if (ownerFilter !== "all") {
        params.append('owner', ownerFilter);
      }
      

      
      const url = `https://orbiti.fareportal.com:7000/api/hosts_paged?${params.toString()}`;
      console.log('Fetching hosts with URL:', url);
      
      const response = await apiFetch(url, {
        headers: { accept: 'application/json' }
      });
      if (response.ok) {
        const data = await response.json();
        console.log('Hosts response:', data);
        setAssets(data.hosts || []);
        setTotalPages(data.total_pages || 1);
        setTotalCount(data.total || 0);
      } else {
        console.error('Failed to fetch hosts:', response.status, response.statusText);
        toast({
          title: "Error",
          description: "Failed to fetch assets",
          variant: "destructive",
        });
      }
    } catch (error) {
      console.error('Error fetching assets:', error);
      toast({
        title: "Error",
        description: "Failed to fetch assets",
        variant: "destructive",
      });
    } finally {
      setIsLoading(false);
    }
  };

  // Create new asset (using existing addhosts endpoint)
  const handleCreateAsset = async () => {
    try {
      const response = await apiFetch("https://orbiti.fareportal.com:7000/api/addhosts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          hostname: newAsset.hostname,
          host_ip: newAsset.host_ip,
          server_owner: newAsset.server_owner,
          application_dependent: newAsset.application_dependent,
          os_name: newAsset.os_name,
          status: newAsset.status
        }),
      });
      
      if (response.ok) {
        setShowCreateModal(false);
        setNewAsset({
          hostname: "",
          host_ip: "",
          server_owner: "",
          application_dependent: "",
          os_name: "Unknown",
          status: "online"
        });
        fetchAssets();
        fetchAssetStats();
        toast({
          title: "Success",
          description: `Asset "${newAsset.hostname}" created successfully`,
        });
      } else {
        const error = await response.json();
        toast({
          title: "Error",
          description: error.detail || "Failed to create asset",
          variant: "destructive",
        });
      }
    } catch (error) {
      console.error('Error creating asset:', error);
      toast({
        title: "Error",
        description: "Failed to create asset",
        variant: "destructive",
      });
    }
  };

  // Update asset (using existing hosts update endpoint)
  const handleUpdateAsset = async () => {
    if (!selectedAsset) return;
    
    try {
      const response = await apiFetch(`https://orbiti.fareportal.com:7000/api/hosts/${selectedAsset.id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(editAsset),
      });
      
      if (response.ok) {
        const updatedAsset = await response.json();
        setShowEditModal(false);
        setSelectedAsset(null);
        setEditAsset({});
        fetchAssets();
        fetchAssetStats();
        toast({
          title: "Success",
          description: `Asset "${updatedAsset.hostname}" updated successfully`,
        });
      } else {
        const error = await response.json();
        toast({
          title: "Error",
          description: error.detail || "Failed to update asset",
          variant: "destructive",
        });
      }
    } catch (error) {
      console.error('Error updating asset:', error);
      toast({
        title: "Error",
        description: "Failed to update asset",
        variant: "destructive",
      });
    }
  };

  // Delete asset (using existing hosts delete endpoint)
  const handleDeleteAsset = async () => {
    if (!assetToDelete) return;
    
    try {
      const response = await apiFetch(`https://orbiti.fareportal.com:7000/api/hosts/${assetToDelete.id}`, {
        method: "DELETE",
      });
      
      if (response.ok) {
        setShowDeleteDialog(false);
        setAssetToDelete(null);
        fetchAssets();
        fetchAssetStats();
        toast({
          title: "Success",
          description: `Asset "${assetToDelete.hostname}" deleted successfully`,
        });
      } else {
        const error = await response.json();
        toast({
          title: "Error",
          description: error.detail || "Failed to delete asset",
          variant: "destructive",
        });
      }
    } catch (error) {
      console.error('Error deleting asset:', error);
      toast({
        title: "Error",
        description: "Failed to delete asset",
        variant: "destructive",
      });
    }
  };

  // Bulk delete assets (using existing hosts bulk delete endpoint)
  const handleBulkDelete = async () => {
    if (selectedAssets.length === 0) return;
    
    try {
      const response = await apiFetch("https://orbiti.fareportal.com:7000/api/hosts/bulk", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ host_ids: selectedAssets }),
      });
      
      if (response.ok) {
        const result = await response.json();
        setShowBulkDeleteDialog(false);
        setSelectedAssets([]);
        fetchAssets();
        fetchAssetStats();
        toast({
          title: "Success",
          description: `Deleted ${result.deleted_count || selectedAssets.length} assets successfully`,
        });
      } else {
        const error = await response.json();
        toast({
          title: "Error",
          description: error.detail || "Failed to delete assets",
          variant: "destructive",
        });
      }
    } catch (error) {
      console.error('Error bulk deleting assets:', error);
      toast({
        title: "Error",
        description: "Failed to delete assets",
        variant: "destructive",
      });
    }
  };

  // Handle CSV upload for updating assets
  const handleCsvUpload = async () => {
    if (!csvFile) return;
    
    setIsCsvUploading(true);
    try {
      const formData = new FormData();
      formData.append("file", csvFile);
      
      const response = await apiFetch("https://orbiti.fareportal.com:7000/api/hosts/update_from_csv", {
        method: "POST",
        body: formData,
      });
      
      if (response.ok) {
        const result = await response.json();
        setShowCsvUploadModal(false);
        setCsvFile(null);
        fetchAssets();
        fetchAssetStats();
        toast({
          title: "Success",
          description: `Updated ${result.updated_hosts || 0} assets from CSV`,
        });
      } else {
        const error = await response.json();
        toast({
          title: "Error",
          description: error.detail || "Failed to upload CSV",
          variant: "destructive",
        });
      }
    } catch (error) {
      console.error('Error uploading CSV:', error);
      toast({
        title: "Error",
        description: "Failed to upload CSV",
        variant: "destructive",
      });
    } finally {
      setIsCsvUploading(false);
    }
  };



  // Handle asset selection for bulk operations
  const handleAssetSelection = (assetId: number, checked: boolean) => {
    if (checked) {
      setSelectedAssets(prev => [...prev, assetId]);
    } else {
      setSelectedAssets(prev => prev.filter(id => id !== assetId));
    }
  };

  // Handle select all
  const handleSelectAll = (checked: boolean) => {
    if (checked) {
      setSelectedAssets(assets.map(asset => asset.id));
    } else {
      setSelectedAssets([]);
    }
  };

  // Initialize data
  useEffect(() => {
    fetchAssetStats();
    fetchAssetOwners();
    fetchOsTypes();
  }, []);

  // Debounced search effect
  useEffect(() => {
    const timeoutId = setTimeout(() => {
      setPage(1); // Reset to first page when searching
      fetchAssets();
    }, 300); // 300ms debounce

    return () => clearTimeout(timeoutId);
  }, [searchTerm]);

  // Effect for other filters (no debounce needed)
  useEffect(() => {
    setPage(1); // Reset to first page when filters change
    fetchAssets();
  }, [statusFilter, ownerFilter]);

  // Effect for pagination changes
  useEffect(() => {
    fetchAssets();
  }, [page, pageSize]);

  const getStatusIcon = (status: string | null) => {
    switch (status?.toLowerCase()) {
      case "online":
      case "active":
        return <CheckCircle className="h-4 w-4 text-green-500" />;
      case "offline":
      case "inactive":
        return <XCircle className="h-4 w-4 text-red-500" />;
      default:
        return <AlertCircle className="h-4 w-4 text-yellow-500" />;
    }
  };

  const getStatusBadge = (status: string | null) => {
    const statusKey = status?.toLowerCase() || "unknown";
    const configs = {
      online: {
        className: "bg-green-500/20 text-green-400 border border-green-500/30 shadow-sm",
      },
      active: {
        className: "bg-green-500/20 text-green-400 border border-green-500/30 shadow-sm",
      },
      offline: {
        className: "bg-red-500/20 text-red-400 border border-red-500/30 shadow-sm",
      },
      inactive: {
        className: "bg-red-500/20 text-red-400 border border-red-500/30 shadow-sm",
      },
      unknown: {
        className: "bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 shadow-sm",
      },
    };
    
    const config = configs[statusKey as keyof typeof configs] || configs.unknown;
    return (
      <Badge variant="secondary" className={config.className + " transition-all duration-200"}>
        <div className="flex items-center gap-1">
          {getStatusIcon(status)}
          {statusKey.charAt(0).toUpperCase() + statusKey.slice(1)}
        </div>
      </Badge>
    );
  };

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold text-primary">Asset Management</h1>
          <p className="text-muted-foreground">
            Monitor and manage your network assets
          </p>
        </div>
        <div className="flex gap-2">
          <Button 
            onClick={() => setShowCreateModal(true)} 
            className="hover:bg-primary/90 transition-all"
          >
            <Plus className="h-4 w-4 mr-2" />
            Add Asset
          </Button>
          <Button 
            onClick={() => setShowCsvUploadModal(true)} 
            className="hover:bg-blue-600/90 transition-all"
          >
            Update from CSV
          </Button>

          {selectedAssets.length > 0 && (
            <AlertDialog open={showBulkDeleteDialog} onOpenChange={setShowBulkDeleteDialog}>
              <AlertDialogTrigger asChild>
                <Button variant="destructive" className="hover:bg-red-600/90 transition-all">
                  <Trash2 className="h-4 w-4 mr-2" />
                  Delete Selected ({selectedAssets.length})
                </Button>
              </AlertDialogTrigger>
              <AlertDialogContent>
                <AlertDialogHeader>
                  <AlertDialogTitle>Delete Selected Assets</AlertDialogTitle>
                  <AlertDialogDescription>
                    Are you sure you want to delete {selectedAssets.length} selected assets? This action cannot be undone.
                  </AlertDialogDescription>
                </AlertDialogHeader>
                <AlertDialogFooter>
                  <AlertDialogCancel>Cancel</AlertDialogCancel>
                  <AlertDialogAction onClick={handleBulkDelete} className="bg-red-600 hover:bg-red-700">
                    Delete
                  </AlertDialogAction>
                </AlertDialogFooter>
              </AlertDialogContent>
            </AlertDialog>
          )}
          <Button 
            onClick={() => {
              fetchAssets();
              fetchAssetStats();
            }} 
            disabled={isLoading}
            className="hover:bg-muted transition-all"
          >
            <RefreshCw className={`h-4 w-4 mr-2 ${isLoading ? "animate-spin" : ""}`} />
            Refresh
          </Button>
        </div>
      </div>

      {/* Asset Statistics */}
      {assetStats && (
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <Card>
            <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
              <CardTitle className="text-sm font-medium">Total Assets</CardTitle>
              <Monitor className="h-4 w-4 text-muted-foreground" />
            </CardHeader>
            <CardContent>
              <div className="text-2xl font-bold">{assetStats.total_assets}</div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
              <CardTitle className="text-sm font-medium">Active</CardTitle>
              <CheckCircle className="h-4 w-4 text-green-500" />
            </CardHeader>
            <CardContent>
              <div className="text-2xl font-bold text-green-500">{assetStats.active_assets}</div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
              <CardTitle className="text-sm font-medium">Inactive</CardTitle>
              <XCircle className="h-4 w-4 text-red-500" />
            </CardHeader>
            <CardContent>
              <div className="text-2xl font-bold text-red-500">{assetStats.inactive_assets}</div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
              <CardTitle className="text-sm font-medium">OS Types</CardTitle>
              <Filter className="h-4 w-4 text-blue-500" />
            </CardHeader>
            <CardContent>
              <div className="text-2xl font-bold text-blue-500">{Object.keys(assetStats.os_distribution).length}</div>
            </CardContent>
          </Card>
        </div>
      )}

      {/* Filters */}
      <div className="flex gap-4 flex-wrap">
        <div className="relative flex-1 min-w-[300px]">
          <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground" />
          <Input
            placeholder="Search by hostname or IP address..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="pl-10"
          />
        </div>
        
        <Select value={statusFilter} onValueChange={(value) => {
          console.log('Status filter changed to:', value);
          setStatusFilter(value);
        }}>
          <SelectTrigger className="w-48">
            <SelectValue placeholder="Filter by status" />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">All Status</SelectItem>
            <SelectItem value="online">Online</SelectItem>
            <SelectItem value="offline">Offline</SelectItem>
            <SelectItem value="active">Active (Legacy)</SelectItem>
            <SelectItem value="inactive">Inactive (Legacy)</SelectItem>
          </SelectContent>
        </Select>

        <Select value={ownerFilter} onValueChange={(value) => {
          console.log('Owner filter changed to:', value);
          setOwnerFilter(value);
        }}>
          <SelectTrigger className="w-48">
            <SelectValue placeholder="Filter by owner" />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="all">All Owners</SelectItem>
            {ownerOptions.map(owner => (
              <SelectItem key={owner} value={owner}>{owner}</SelectItem>
            ))}
          </SelectContent>
        </Select>



      </div>

      {/* Assets Table */}
      <Card>
        <CardHeader>
          <CardTitle>Network Assets</CardTitle>
          <CardDescription>
            All discovered assets in your network ({totalCount} total)
          </CardDescription>
        </CardHeader>
        <CardContent>
          {isLoading ? (
            <div className="flex items-center justify-center py-8">
              <RefreshCw className="h-6 w-6 animate-spin mr-2" />
              Loading assets...
            </div>
          ) : (
            <>
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead className="w-12">
                      <input
                        type="checkbox"
                        checked={selectedAssets.length === assets.length && assets.length > 0}
                        onChange={(e) => handleSelectAll(e.target.checked)}
                        className="rounded border-gray-300"
                      />
                    </TableHead>
                    <TableHead>Hostname</TableHead>
                    <TableHead>IP Address</TableHead>
                    <TableHead>Status</TableHead>
                    <TableHead>Owner</TableHead>
                    <TableHead>Last Scan</TableHead>
                    <TableHead className="w-12">Actions</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {assets.map((asset) => (
                    <TableRow key={asset.id}>
                      <TableCell>
                        <input
                          type="checkbox"
                          checked={selectedAssets.includes(asset.id)}
                          onChange={(e) => handleAssetSelection(asset.id, e.target.checked)}
                          className="rounded border-gray-300"
                        />
                      </TableCell>
                      <TableCell className="font-medium">{asset.hostname}</TableCell>
                      <TableCell>{asset.host_ip}</TableCell>
                      <TableCell>{getStatusBadge(asset.status)}</TableCell>
                      <TableCell>{asset.server_owner || "—"}</TableCell>
                      <TableCell>{asset.last_scan_date ? new Date(asset.last_scan_date).toLocaleDateString() : "—"}</TableCell>
                      <TableCell>
                        <div className="flex gap-2">
                          <Button
                            variant="ghost"
                            size="sm"
                            onClick={() => {
                              setSelectedAsset(asset);
                              setEditAsset({
                                hostname: asset.hostname,
                                host_ip: asset.host_ip,
                                server_owner: asset.server_owner || "",
                                application_dependent: asset.application_dependent || "",
                                os_name: asset.os_name || "",
                                status: asset.status || ""
                              });
                              setShowEditModal(true);
                            }}
                          >
                            <Edit className="h-4 w-4" />
                          </Button>
                          <Button
                            variant="ghost"
                            size="sm"
                            onClick={() => {
                              setAssetToDelete(asset);
                              setShowDeleteDialog(true);
                            }}
                            className="text-red-600 hover:text-red-700"
                          >
                            <Trash2 className="h-4 w-4" />
                          </Button>
                        </div>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>

              {/* Pagination controls */}
              <div className="flex items-center justify-between mt-4">
                <div className="flex items-center gap-2">
                  <span>Rows per page:</span>
                  <Select value={pageSize.toString()} onValueChange={val => { setPageSize(Number(val)); setPage(1); }}>
                    <SelectTrigger className="w-20">
                      <SelectValue />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="10">10</SelectItem>
                      <SelectItem value="20">20</SelectItem>
                      <SelectItem value="50">50</SelectItem>
                      <SelectItem value="100">100</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
                <div className="flex items-center gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    disabled={page === 1}
                    onClick={() => setPage(page - 1)}
                  >
                    <ChevronLeft className="h-4 w-4" />
                  </Button>
                  <span>
                    Page {page} of {totalPages}
                  </span>
                  <Button
                    variant="outline"
                    size="sm"
                    disabled={page === totalPages}
                    onClick={() => setPage(page + 1)}
                  >
                    <ChevronRight className="h-4 w-4" />
                  </Button>
                  <span className="ml-4 text-muted-foreground">
                    {totalCount} assets
                  </span>
                </div>
              </div>
            </>
          )}
          
          {!isLoading && assets.length === 0 && (
            <div className="text-center py-8 text-muted-foreground">
              No assets found matching your criteria
            </div>
          )}
        </CardContent>
      </Card>

      {/* Create Asset Modal */}
      <Dialog open={showCreateModal} onOpenChange={setShowCreateModal}>
        <DialogContent className="sm:max-w-[500px]">
          <DialogHeader>
            <DialogTitle>Add New Asset</DialogTitle>
            <DialogDescription>
              Create a new asset in your network inventory.
            </DialogDescription>
          </DialogHeader>
          <div className="grid gap-4 py-4">
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="hostname">Hostname *</Label>
                <Input
                  id="hostname"
                  value={newAsset.hostname}
                  onChange={(e) => setNewAsset({ ...newAsset, hostname: e.target.value })}
                  placeholder="web-server-01"
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="host_ip">IP Address *</Label>
                <Input
                  id="host_ip"
                  value={newAsset.host_ip}
                  onChange={(e) => setNewAsset({ ...newAsset, host_ip: e.target.value })}
                  placeholder="192.168.1.100"
                />
              </div>
            </div>
            <div className="space-y-2">
              <Label htmlFor="server_owner">Server Owner</Label>
              <Input
                id="server_owner"
                value={newAsset.server_owner}
                onChange={(e) => setNewAsset({ ...newAsset, server_owner: e.target.value })}
                placeholder="IT Department"
              />
            </div>
            <div className="space-y-2">
              <Label htmlFor="application_dependent">Application Dependent</Label>
              <Input
                id="application_dependent"
                value={newAsset.application_dependent}
                onChange={(e) => setNewAsset({ ...newAsset, application_dependent: e.target.value })}
                placeholder="Web Server, Database, etc."
              />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="os_name">Operating System</Label>
                <Select value={newAsset.os_name} onValueChange={(value) => setNewAsset({ ...newAsset, os_name: value })}>
                  <SelectTrigger>
                    <SelectValue placeholder="Select OS" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="Windows">Windows</SelectItem>
                    <SelectItem value="Linux">Linux</SelectItem>
                    <SelectItem value="macOS">macOS</SelectItem>
                    <SelectItem value="Unknown">Unknown</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-2">
                <Label htmlFor="status">Status</Label>
                <Select value={newAsset.status} onValueChange={(value) => setNewAsset({ ...newAsset, status: value })}>
                  <SelectTrigger>
                    <SelectValue placeholder="Select status" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="online">Online</SelectItem>
                    <SelectItem value="offline">Offline</SelectItem>
                    <SelectItem value="active">Active (Legacy)</SelectItem>
                    <SelectItem value="inactive">Inactive (Legacy)</SelectItem>
                  </SelectContent>
                </Select>
              </div>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowCreateModal(false)}>
              Cancel
            </Button>
            <Button onClick={handleCreateAsset} disabled={!newAsset.hostname || !newAsset.host_ip}>
              Create Asset
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Edit Asset Modal */}
      <Dialog open={showEditModal} onOpenChange={setShowEditModal}>
        <DialogContent className="sm:max-w-[500px]">
          <DialogHeader>
            <DialogTitle>Edit Asset</DialogTitle>
            <DialogDescription>
              Update asset information.
            </DialogDescription>
          </DialogHeader>
          <div className="grid gap-4 py-4">
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="edit-hostname">Hostname</Label>
                <Input
                  id="edit-hostname"
                  value={editAsset.hostname || ""}
                  onChange={(e) => setEditAsset({ ...editAsset, hostname: e.target.value })}
                  placeholder="web-server-01"
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="edit-host_ip">IP Address</Label>
                <Input
                  id="edit-host_ip"
                  value={editAsset.host_ip || ""}
                  onChange={(e) => setEditAsset({ ...editAsset, host_ip: e.target.value })}
                  placeholder="192.168.1.100"
                />
              </div>
            </div>
            <div className="space-y-2">
              <Label htmlFor="edit-server_owner">Server Owner</Label>
              <Input
                id="edit-server_owner"
                value={editAsset.server_owner || ""}
                onChange={(e) => setEditAsset({ ...editAsset, server_owner: e.target.value })}
                placeholder="IT Department"
              />
            </div>
            <div className="space-y-2">
              <Label htmlFor="edit-application_dependent">Application Dependent</Label>
              <Input
                id="edit-application_dependent"
                value={editAsset.application_dependent || ""}
                onChange={(e) => setEditAsset({ ...editAsset, application_dependent: e.target.value })}
                placeholder="Web Server, Database, etc."
              />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="edit-os_name">Operating System</Label>
                <Select value={editAsset.os_name || ""} onValueChange={(value) => setEditAsset({ ...editAsset, os_name: value })}>
                  <SelectTrigger>
                    <SelectValue placeholder="Select OS" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="Windows">Windows</SelectItem>
                    <SelectItem value="Linux">Linux</SelectItem>
                    <SelectItem value="macOS">macOS</SelectItem>
                    <SelectItem value="Unknown">Unknown</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-2">
                <Label htmlFor="edit-status">Status</Label>
                <Select value={editAsset.status || ""} onValueChange={(value) => setEditAsset({ ...editAsset, status: value })}>
                  <SelectTrigger>
                    <SelectValue placeholder="Select status" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="online">Online</SelectItem>
                    <SelectItem value="offline">Offline</SelectItem>
                    <SelectItem value="active">Active (Legacy)</SelectItem>
                    <SelectItem value="inactive">Inactive (Legacy)</SelectItem>
                  </SelectContent>
                </Select>
              </div>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowEditModal(false)}>
              Cancel
            </Button>
            <Button onClick={handleUpdateAsset}>
              Update Asset
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Delete Asset Dialog */}
      <AlertDialog open={showDeleteDialog} onOpenChange={setShowDeleteDialog}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>Delete Asset</AlertDialogTitle>
            <AlertDialogDescription>
              Are you sure you want to delete the asset "{assetToDelete?.hostname}" ({assetToDelete?.host_ip})? 
              This action cannot be undone.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction onClick={handleDeleteAsset} className="bg-red-600 hover:bg-red-700">
              Delete
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>

      {/* CSV Upload Modal */}
      <Dialog open={showCsvUploadModal} onOpenChange={setShowCsvUploadModal}>
        <DialogContent className="sm:max-w-[500px]">
          <DialogHeader>
            <DialogTitle>Update Assets from CSV</DialogTitle>
            <DialogDescription>
              Upload a CSV file to update existing assets. The CSV should contain columns: AssetIPAddress, AssetUniqueName, AssetsApplication/Owner
            </DialogDescription>
          </DialogHeader>
          <div className="grid gap-4 py-4">
            <div className="space-y-2">
              <Label htmlFor="csv-file">CSV File</Label>
              <Input
                id="csv-file"
                type="file"
                accept=".csv"
                onChange={(e: ChangeEvent<HTMLInputElement>) => {
                  if (e.target.files && e.target.files[0]) {
                    setCsvFile(e.target.files[0]);
                  }
                }}
                className="file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
              />
            </div>
            <div className="text-sm text-muted-foreground">
              <p><strong>Expected CSV columns:</strong></p>
              <ul className="list-disc list-inside mt-2 space-y-1">
                <li><code>AssetIPAddress</code> - IP address of the asset</li>
                <li><code>AssetUniqueName</code> - Hostname of the asset</li>
                <li><code>AssetsApplication/Owner</code> - Owner information</li>
              </ul>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowCsvUploadModal(false)}>
              Cancel
            </Button>
            <Button 
              onClick={handleCsvUpload} 
              disabled={!csvFile || isCsvUploading}
              className="bg-blue-600 hover:bg-blue-700"
            >
              {isCsvUploading ? (
                <>
                  <RefreshCw className="h-4 w-4 mr-2 animate-spin" />
                  Uploading...
                </>
              ) : (
                'Upload CSV'
              )}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
